{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ESNext",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "bundler",
		"importHelpers": true,
		"downlevelIteration": true,
		"incremental": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"lib": ["DOM", "ESNext"]
	},
	"include": ["src/**/*.ts"]
}
